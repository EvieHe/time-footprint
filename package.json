{
  "name": "time-footprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:e2e": "playwright test",
    "test:mobile": "node --test tests/mobile-*.test.mjs",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron": "^35.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2",
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.55.0",
    "@capacitor/cli": "^8.5.0"
  }
}
